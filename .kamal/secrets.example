# Copy this file to .kamal/secrets, then replace every placeholder. The local
# registry configured in deploy.yml does not need registry credentials.

APP_KEY=replace-with-output-from-php-artisan-key-generate-show
VAULT_ENCRYPTION_KEY=replace-with-output-from-php-artisan-vault-key-show
DB_PASSWORD=replace-with-a-long-random-password
POSTGRES_PASSWORD=$DB_PASSWORD
